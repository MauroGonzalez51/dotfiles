{
    "clipboard": {
        "tmpfs": false
    },
    "disks": [
        "/",
        "/mnt/teamgroup_1tb/"
    ],
    "idle": {
        "general": {
            "after_sleep_cmd": "ambxst screen on",
            "before_sleep_cmd": "loginctl lock-session",
            "lock_cmd": "ambxst lock"
        },
        "listeners": [
            {
                "onResume": "axctl brightness restore",
                "onTimeout": "axctl brightness save && axctl brightness set 0.1",
                "timeout": 150
            },
            {
                "onTimeout": "loginctl lock-session",
                "timeout": 300
            },
            {
                "onResume": "ambxst screen on",
                "onTimeout": "ambxst screen off",
                "timeout": 330
            },
            {
                "onTimeout": "ambxst suspend",
                "timeout": 1800
            }
        ]
    },
    "language": "auto",
    "ocr": {
        "chi_sim": false,
        "chi_tra": false,
        "eng": true,
        "jpn": false,
        "kor": false,
        "lat": false,
        "rus": false,
        "spa": true
    },
    "pomodoro": {
        "autoStart": false,
        "restTime": 300,
        "syncSpotify": false,
        "workTime": 1500
    },
    "updateServiceEnabled": true
}
