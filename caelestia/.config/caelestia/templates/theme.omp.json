{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "color1": "#{{ term1.hex }}",
    "color2": "#{{ term2.hex }}",
    "color3": "#{{ term3.hex }}",
    "color4": "#{{ term4.hex }}",
    "color5": "#{{ term5.hex }}",
    "color6": "#{{ term6.hex }}",
    "color7": "#{{ term7.hex }}",
    "color8": "#{{ term8.hex }}",
    "color9": "#{{ term9.hex }}",
    "color10": "#{{ term10.hex }}",
    "color11": "#{{ term11.hex }}",
    "color12": "#{{ term12.hex }}",
    "color13": "#{{ term13.hex }}",
    "color14": "#{{ term14.hex }}",
    "color15": "#{{ term15.hex }}",
    "background": "#{{ background.hex }}",
    "foreground": "#{{ onBackground.hex }}"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:color3",
          "style": "plain",
          "template": "<p:color3>┏[</>{{ .UserName }}<p:color3>]</>",
          "type": "session"
        },
        {
          "foreground": "p:color8",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "<p:color4>--[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<p:color14> ● </>{{ end }}{{ if .Staging.Changed }}<p:color6> ● </>{{ end }}<p:color4>]</>",
          "type": "git"
        },
        {
          "foreground": "p:color5",
          "style": "plain",
          "template": "<p:color4>--[</>{{.Profile}}{{if .Region}}@{{.Region}}{{end}}<p:color4>]</>",
          "type": "aws"
        },
        {
          "foreground": "p:color5",
          "style": "plain",
          "template": "<p:color4>--[</>{{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}<p:color4>]</>",
          "type": "kubectl"
        },
        {
          "foreground": "p:foreground",
          "style": "plain",
          "template": "<p:color4>[</><p:color4>]</>",
          "type": "root"
        },
        {
          "foreground": "p:foreground",
          "style": "plain",
          "template": "<p:color1>[x</>{{ reason .Code }}<p:color1>]</>",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:color3",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "<p:color3>┖[</>{{ .Path }}<p:color3>]</>",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:color10",
          "style": "plain",
          "template": "  ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
