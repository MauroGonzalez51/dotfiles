{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "color1": "#65F1A4",
    "color2": "#5CB545",
    "color3": "#558C6B",
    "color4": "#54844D",
    "color5": "#8A7847",
    "color6": "#6A6748",
    "color7": "#848697",
    "color8": "#5C5E69",
    "color9": "#65F1A4",
    "color10": "#5CB545",
    "color11": "#558C6B",
    "color12": "#54844D",
    "color13": "#8A7847",
    "color14": "#6A6748",
    "color15": "#848697",
    "background": "#120009",
    "foreground": "#AFB0BC"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:color3",
          "style": "plain",
          "template": "<p:color3>┏[</>{{ .UserName }}<p:color3>]</>",
          "type": "session"
        },
        {
          "foreground": "p:color8",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "<p:color4>--[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<p:color14> ● </>{{ end }}{{ if .Staging.Changed }}<p:color6> ● </>{{ end }}<p:color4>]</>",
          "type": "git"
        },
        {
          "foreground": "p:color5",
          "style": "plain",
          "template": "<p:color4>--[</>{{.Profile}}{{if .Region}}@{{.Region}}{{end}}<p:color4>]</>",
          "type": "aws"
        },
        {
          "foreground": "p:color5",
          "style": "plain",
          "template": "<p:color4>--[</>{{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}<p:color4>]</>",
          "type": "kubectl"
        },
        {
          "foreground": "p:foreground",
          "style": "plain",
          "template": "<p:color4>[</><p:color4>]</>",
          "type": "root"
        },
        {
          "foreground": "p:foreground",
          "style": "plain",
          "template": "<p:color1>[x</>{{ reason .Code }}<p:color1>]</>",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:color3",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "<p:color3>┖[</>{{ .Path }}<p:color3>]</>",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:color10",
          "style": "plain",
          "template": "  ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
