{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "color1": "#66A54F",
    "color2": "#1E8A41",
    "color3": "#4F8A20",
    "color4": "#598268",
    "color5": "#45663E",
    "color6": "#39C31E",
    "color7": "#CC8CD9",
    "color8": "#8F6298",
    "color9": "#66A54F",
    "color10": "#1E8A41",
    "color11": "#4F8A20",
    "color12": "#598268",
    "color13": "#45663E",
    "color14": "#39C31E",
    "color15": "#CC8CD9",
    "background": "#0F0010",
    "foreground": "#E1B5EA"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:color3",
          "style": "plain",
          "template": "<p:color3>┏[</>{{ .UserName }}<p:color3>]</>",
          "type": "session"
        },
        {
          "foreground": "p:color8",
          "options": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "<p:color4>--[</>{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}<p:color14> ● </>{{ end }}{{ if .Staging.Changed }}<p:color6> ● </>{{ end }}<p:color4>]</>",
          "type": "git"
        },
        {
          "foreground": "p:color5",
          "style": "plain",
          "template": "<p:color4>--[</>{{.Profile}}{{if .Region}}@{{.Region}}{{end}}<p:color4>]</>",
          "type": "aws"
        },
        {
          "foreground": "p:color5",
          "style": "plain",
          "template": "<p:color4>--[</>{{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}}<p:color4>]</>",
          "type": "kubectl"
        },
        {
          "foreground": "p:foreground",
          "style": "plain",
          "template": "<p:color4>[</><p:color4>]</>",
          "type": "root"
        },
        {
          "foreground": "p:foreground",
          "style": "plain",
          "template": "<p:color1>[x</>{{ reason .Code }}<p:color1>]</>",
          "type": "status"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:color3",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "<p:color3>┖[</>{{ .Path }}<p:color3>]</>",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:color10",
          "style": "plain",
          "template": "  ",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
